DATABASE_URL=            # Supabase transaction pooler URI (port 6543), used by the app at runtime
DATABASE_URL_DIRECT=     # Supabase session pooler URI (port 5432), used by drizzle-kit
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=             # Cerebras key (cloud.cerebras.ai)
LLM_FALLBACK_BASE_URL=   # optional second OpenAI-compatible provider
LLM_FALLBACK_API_KEY=
AUTH_SECRET=             # npx auth secret
AUTH_URL=                # prod URL only
DEMO_EMAIL=demo@gauntlet.ai
DEMO_PASSWORD=demo1234

# Model config: provider model IDs, verified against GET $LLM_BASE_URL/models once a key is set
MODEL_CALLER=llama-3.3-70b-versatile
MODEL_AGENT_DEFAULT=llama-3.1-8b-instant
MODEL_JUDGE=qwen/qwen3-32b
MODEL_PERSONA_GEN=llama-3.3-70b-versatile

# Limits
DEMO_MAX_RUNS_PER_DAY=2
MAX_PERSONAS_PER_RUN=10
MAX_TURNS_PER_CONVERSATION=16
LLM_CONCURRENCY=3
